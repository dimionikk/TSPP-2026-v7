<Window x:Class="TrainDispatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrainDispatcher"
        mc:Ignorable="d"
        x:Name="InfoTrainForm"
        Title="Trains — Система обліку потягів"
        SizeToContent="WidthAndHeight"
        Loaded="InfoTrainForm_Loaded"
        Activated="InfoTrainForm_Activated">

    <Window.Resources>
        <Style x:Key="GreenBtn" TargetType="Button">
            <Setter Property="Background" Value="#90EE90"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style x:Key="YellowBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFD700"/>
            <Setter Property="BorderBrush" Value="#FFA500"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style x:Key="BlueBtn" TargetType="Button">
            <Setter Property="Background" Value="#87CEEB"/>
            <Setter Property="BorderBrush" Value="#4169E1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style x:Key="RedBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFB6C1"/>
            <Setter Property="BorderBrush" Value="#DC143C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#90EE90"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu x:Name="MainMenu"
              Grid.Row="0"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              BorderThickness="1,1,1,1">
            <MenuItem x:Name="FileMenuItem" Header="Файл">
                <MenuItem x:Name="LoadDataMenuItem" Header="Завантажити"
                          Click="LoadDataMenuItem_Click"/>
            </MenuItem>
            <MenuItem x:Name="EditMenuItem" Header="Редагувати">
                <MenuItem x:Name="DeleteDataMenuItem" Header="Видалити запис"
                          Click="DeleteDataMenuItem_Click"/>
            </MenuItem>
            <MenuItem x:Name="HelpMenuItem" Header="Довідка">
                <MenuItem x:Name="AuthMenuItem" Header="Авторизація"
                          Click="AuthMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <GroupBox Grid.Row="1" Header="Пошук за містом та часом відправлення:"
                  Margin="5,5,5,0">
            <StackPanel Orientation="Horizontal" Margin="5">
                <Label Content="Місто:"/>
                <TextBox x:Name="citySearchTextBox" Width="100" Margin="0,0,10,0"
                         VerticalContentAlignment="Center"/>
                <Label Content="Від:"/>
                <TextBox x:Name="timeASearchTextBox" Width="70" Margin="0,0,10,0"
                         VerticalContentAlignment="Center"/>
                <Label Content="До:"/>
                <TextBox x:Name="timeBSearchTextBox" Width="70" Margin="0,0,10,0"
                         VerticalContentAlignment="Center"/>
                <Button x:Name="searchXYBtn" Content="Знайти" Width="75"
                        Style="{StaticResource BlueBtn}"
                        Click="SearchXYBtn_Click"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Пошук за номером потяга:"
                  Margin="5,5,5,0">
            <StackPanel Orientation="Horizontal" Margin="5">
                <Label Content="Номер потяга:"/>
                <TextBox x:Name="trainNumSearchTextBox" Width="100" Margin="0,0,10,0"
                         VerticalContentAlignment="Center"/>
                <Button x:Name="searchTicketsBtn" Content="Знайти" Width="75"
                        Margin="0,0,10,0" Style="{StaticResource BlueBtn}"
                        Click="SearchTicketsBtn_Click"/>
                <Button x:Name="resetSearchBtn" Content="Скинути фільтр" Width="100"
                        Click="ResetSearchBtn_Click"/>
            </StackPanel>
        </GroupBox>

        <DataGrid x:Name="TrainListDG"
                  Grid.Row="3"
                  HorizontalAlignment="Stretch"
                  Margin="5,5,5,5"
                  VerticalAlignment="Top"
                  Height="300"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding}"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="Auto"/>
                <DataGridTextColumn Header="Номер потяга" Binding="{Binding train_number}" Width="Auto"/>
                <DataGridTextColumn Header="Станція призначення" Binding="{Binding destination}" Width="Auto"/>
                <DataGridTextColumn Header="Час відправлення" Binding="{Binding departure_time}" Width="Auto"/>
                <DataGridTextColumn Header="Час у дорозі" Binding="{Binding travel_time}" Width="Auto"/>
                <DataGridTextColumn Header="Квитки" Binding="{Binding tickets_available}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="5,0,5,10">
            <Button x:Name="addBtn" Content="Додати" Width="90"
                    Margin="0,0,10,0" Style="{StaticResource GreenBtn}"
                    Click="AddBtn_Click"/>
            <Button x:Name="editBtn" Content="Редагувати" Width="100"
                    Margin="0,0,10,0" Style="{StaticResource YellowBtn}"
                    Click="EditBtn_Click"/>
            <Button x:Name="saveWordBtn" Content="Зберегти у Word" Width="120"
                    Style="{StaticResource BlueBtn}"
                    Click="SaveWordBtn_Click"/>
        </StackPanel>

    </Grid>
</Window>