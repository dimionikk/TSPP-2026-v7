<Window x:Class="TrainDispatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrainDispatcher"
        mc:Ignorable="d"
        x:Name="InfoTrainForm"
        Title="Розклад потягів"
        SizeToContent="WidthAndHeight"
        Loaded="InfoTrainForm_Loaded"
        Activated="InfoTrainForm_Activated">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu x:Name="MainMenu"
              Grid.Row="0"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Height="Auto"
              BorderThickness="1,1,1,1">

            <MenuItem x:Name="FileMenuItem" Header="Файл">
                <MenuItem x:Name="LoadDataMenuItem" Header="Завантажити"
                          Click="LoadDataMenuItem_Click"/>
                <MenuItem x:Name="SaveDataMenuItem" Header="Зберегти"/>
            </MenuItem>

            <MenuItem x:Name="TrainsMenuItem" Header="Потяги">
                <MenuItem x:Name="EditDataMenuItem" Header="Редагувати"
                          Click="EditDataMenuItem_Click"/>
                <MenuItem x:Name="AddDataMenuItem" Header="Додати"
                          Click="AddDataMenuItem_Click"/>
                <MenuItem x:Name="DeleteDataMenuItem" Header="Видалити"
                          Click="DeleteDataMenuItem_Click"/>
            </MenuItem>

            <MenuItem x:Name="SelectMenuItem" Header="Пошук">
                <MenuItem x:Name="SelectXYMenuItem" Header="За часом відправлення"
                          Click="SelectXYMenuItem_Click"/>
                <MenuItem x:Name="SelectTicketsMenuItem" Header="За наявністю квитків"
                          Click="SelectTicketsMenuItem_Click"/>
            </MenuItem>

            <MenuItem x:Name="AuthMenuItem" Header="Авторизація" Click="AuthMenuItem_Click"/>

        </Menu>

        <StackPanel Grid.Row="1" Orientation="Horizontal">

            <DataGrid x:Name="TrainListDG"
                      HorizontalAlignment="Left"
                      Margin="5,5,20,10"
                      VerticalAlignment="Top"
                      Height="420"
                      Width="Auto"
                      AutoGenerateColumns="False"
                      ItemsSource="{Binding}"
                      MouseDoubleClick="TrainListDG_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding id}"
                                        Width="Auto"/>
                    <DataGridTextColumn Header="Номер потяга"
                                        Binding="{Binding train_number}"
                                        Width="Auto"/>
                    <DataGridTextColumn Header="Станція призначення"
                                        Binding="{Binding destination}"
                                        Width="Auto"/>
                    <DataGridTextColumn Header="Час відправлення"
                                        Binding="{Binding departure_time}"
                                        Width="Auto"/>
                    <DataGridTextColumn Header="Час у дорозі"
                                        Binding="{Binding travel_time}"
                                        Width="Auto"/>
                    <DataGridTextColumn Header="Кількість квитків"
                                        Binding="{Binding tickets_available}"
                                        Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Панель редагування/додавання -->
            <GroupBox x:Name="trainGroupBox"
                      Header="Потяг"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="0,5,0,0"
                      Width="220"
                      Visibility="Hidden">
                <Grid VerticalAlignment="Top">
                    <Label x:Name="numTrainLabel" Content="Номер потяга"
                           HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="numTrainTextBox"
                             HorizontalAlignment="Left" Margin="130,12,0,0"
                             VerticalAlignment="Top" Width="70" MaxLength="6"/>

                    <Label x:Name="destTrainLabel" Content="Станція призначення"
                           HorizontalAlignment="Left" Margin="10,40,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="destTrainTextBox"
                             HorizontalAlignment="Left" Margin="130,42,0,0"
                             VerticalAlignment="Top" Width="70"/>

                    <Label x:Name="depTimeLabel" Content="Час відправлення"
                           HorizontalAlignment="Left" Margin="10,70,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="depTimeTextBox"
                             HorizontalAlignment="Left" Margin="130,72,0,0"
                             VerticalAlignment="Top" Width="70" MaxLength="5"/>

                    <Label x:Name="travTimeLabel" Content="Час у дорозі"
                           HorizontalAlignment="Left" Margin="10,100,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="travTimeTextBox"
                             HorizontalAlignment="Left" Margin="130,102,0,0"
                             VerticalAlignment="Top" Width="70" MaxLength="5"/>

                    <Label x:Name="ticketsLabel" Content="Кількість квитків"
                           HorizontalAlignment="Left" Margin="10,130,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="ticketsTextBox"
                             HorizontalAlignment="Left" Margin="130,132,0,0"
                             VerticalAlignment="Top" Width="70" MaxLength="4"/>

                    <Button x:Name="saveBtn" Content="Зберегти"
                            HorizontalAlignment="Left" Margin="10,170,0,0"
                            VerticalAlignment="Top" Width="75"
                            Click="SaveBtn_Click"/>
                </Grid>
            </GroupBox>

            <!-- Панель пошуку UC06 та UC07 -->
            <GroupBox x:Name="searchGroupBox"
                      Header="Пошук рейсів"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="0,5,0,0"
                      Width="220"
                      Visibility="Hidden">
                <Grid VerticalAlignment="Top">

                    <!-- UC06: станція + час A-B -->
                    <Label x:Name="destSearchLabel" Content="Станція призначення"
                           HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"
                           Visibility="Hidden"/>
                    <ComboBox x:Name="destComboBox"
                              HorizontalAlignment="Left" Margin="10,32,0,0"
                              VerticalAlignment="Top" Width="190"
                              Visibility="Hidden"/>

                    <Label x:Name="timeALabel" Content="Час від (гг:хх)"
                           HorizontalAlignment="Left" Margin="10,60,0,0" VerticalAlignment="Top"
                           Visibility="Hidden"/>
                    <TextBox x:Name="timeATextBox"
                             HorizontalAlignment="Left" Margin="10,82,0,0"
                             VerticalAlignment="Top" Width="85" MaxLength="5"
                             Visibility="Hidden"/>

                    <Label x:Name="timeBLabel" Content="Час до (гг:хх)"
                           HorizontalAlignment="Left" Margin="110,60,0,0" VerticalAlignment="Top"
                           Visibility="Hidden"/>
                    <TextBox x:Name="timeBTextBox"
                             HorizontalAlignment="Left" Margin="110,82,0,0"
                             VerticalAlignment="Top" Width="85" MaxLength="5"
                             Visibility="Hidden"/>

                    <!-- UC07: номер потяга -->
                    <Label x:Name="trainNumSearchLabel" Content="Номер потяга"
                           HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"
                           Visibility="Hidden"/>
                    <TextBox x:Name="trainNumSearchTextBox"
                             HorizontalAlignment="Left" Margin="10,32,0,0"
                             VerticalAlignment="Top" Width="190" MaxLength="10"
                             Visibility="Hidden"/>

                    <!-- Кнопки -->
                    <Button x:Name="selBtn" Content="Вибрати"
                            HorizontalAlignment="Left" Margin="10,120,0,0"
                            VerticalAlignment="Top" Width="85"
                            Click="SelBtn_Click"/>

                    <Button x:Name="resetBtn" Content="Скинути"
                            HorizontalAlignment="Left" Margin="110,120,0,0"
                            VerticalAlignment="Top" Width="85"
                            Click="ResetBtn_Click"/>
                </Grid>
            </GroupBox>

        </StackPanel>

    </Grid>
</Window>