<Window x:Class="TrainDispatcher.EditForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrainDispatcher"
        mc:Ignorable="d"
        Title="Додавання / Редагування запису"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Closed="EditForm_Closed">

    <Window.Resources>
        <Style x:Key="GreenBtn" TargetType="Button">
            <Setter Property="Background" Value="#90EE90"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style x:Key="RedBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFB6C1"/>
            <Setter Property="BorderBrush" Value="#DC143C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Номер потяга:" VerticalAlignment="Center"/>
        <TextBox x:Name="numTrainTextBox" Grid.Row="0" Grid.Column="1"
                 Margin="0,5,0,5" MaxLength="10"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Станція призначення:" VerticalAlignment="Center"/>
        <TextBox x:Name="destTrainTextBox" Grid.Row="1" Grid.Column="1"
                 Margin="0,5,0,5"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Час відправлення:" VerticalAlignment="Center"/>
        <TextBox x:Name="depTimeTextBox" Grid.Row="2" Grid.Column="1"
                 Margin="0,5,0,5" MaxLength="5"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Час у дорозі:" VerticalAlignment="Center"/>
        <TextBox x:Name="travTimeTextBox" Grid.Row="3" Grid.Column="1"
                 Margin="0,5,0,5" MaxLength="5"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Кількість квитків:" VerticalAlignment="Center"/>
        <TextBox x:Name="ticketsTextBox" Grid.Row="4" Grid.Column="1"
                 Margin="0,5,0,5" MaxLength="4"/>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="saveBtn" Content="Зберегти" Width="90"
                    Margin="0,0,15,0" Style="{StaticResource GreenBtn}"
                    Click="SaveBtn_Click"/>
            <Button x:Name="cancelBtn" Content="Скасувати" Width="90"
                    Style="{StaticResource RedBtn}"
                    Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>